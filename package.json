{
  "name": "@red-cup-engineering/computing-with-the-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web computing library: the web tier topology, IndieWeb auth and posting, ActivityPub, syndication feeds, pagination, theming, and web-domain app surfaces built on the HTTP primitives and HTTP server.",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .tmp/test-dist/webmention/index.test.mjs .tmp/test-dist/triple-pattern-fragments/index.test.mjs .tmp/test-dist/theming-computer/index.test.mjs .tmp/test-dist/theming/index.test.mjs .tmp/test-dist/taxonomy/index.test.mjs .tmp/test-dist/taxonomy/receiving.test.mjs src/taxonomy/index.http.test.mjs test/swarm-taxonomy.test.mjs .tmp/test-dist/evidence.test.mjs .tmp/test-dist/sync-guard/wire.test.mjs .tmp/test-dist/sync-guard/index.test.mjs .tmp/test-dist/topology/traversal.test.mjs .tmp/test-dist/pagination/history.test.mjs .tmp/test-dist/theming/admission.test.mjs test/indieauth-token.test.mjs test/evidence-boundary.test.mjs test/sync-guard.http.test.mjs test/provider-contracts.test.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./topology": {
      "types": "./dist/topology/index.d.mts",
      "import": "./dist/topology/index.mjs"
    },
    "./jsonrpc": {
      "types": "./dist/jsonrpc/index.d.mts",
      "import": "./dist/jsonrpc/index.mjs"
    },
    "./theming": {
      "types": "./dist/theming/index.d.mts",
      "import": "./dist/theming/index.mjs"
    },
    "./theming-computer": {
      "types": "./dist/theming-computer/index.d.mts",
      "import": "./dist/theming-computer/index.mjs"
    },
    "./feed": {
      "types": "./dist/feed/index.d.mts",
      "import": "./dist/feed/index.mjs"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.mts",
      "import": "./dist/pagination/index.mjs"
    },
    "./indieauth": {
