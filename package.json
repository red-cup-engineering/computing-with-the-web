{
  "name": "@red-cup-engineering/computing-with-the-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web computing library: the web tier topology, IndieWeb auth and posting, ActivityPub, syndication feeds, pagination, theming, and web-domain app surfaces built on the HTTP primitives and HTTP server.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .tmp/test-dist/webmention/index.test.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./topology": {
      "types": "./dist/topology/index.d.mts",
      "import": "./dist/topology/index.mjs"
    },
    "./jsonrpc": {
      "types": "./dist/jsonrpc/index.d.mts",
      "import": "./dist/jsonrpc/index.mjs"
    },
    "./theming": {
      "types": "./dist/theming/index.d.mts",
      "import": "./dist/theming/index.mjs"
    },
    "./theming-computer": {
      "types": "./dist/theming-computer/index.d.mts",
      "import": "./dist/theming-computer/index.mjs"
    },
    "./feed": {
      "types": "./dist/feed/index.d.mts",
      "import": "./dist/feed/index.mjs"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.mts",
      "import": "./dist/pagination/index.mjs"
    },
    "./indieauth": {
      "types": "./dist/indieauth/index.d.mts",
      "import": "./dist/indieauth/index.mjs"
    },
    "./micropub": {
      "types": "./dist/micropub/index.d.mts",
      "import": "./dist/micropub/index.mjs"
    },
    "./microsub": {
      "types": "./dist/microsub/index.d.mts",
      "import": "./dist/microsub/index.mjs"
    },
    "./webmention": {
      "types": "./dist/webmention/index.d.mts",
      "import": "./dist/webmention/index.mjs"
    },
    "./oauth-google": {
      "types": "./dist/oauth-google/index.d.mts",
      "import": "./dist/oauth-google/index.mjs"
    },
    "./federation-discovery": {
      "types": "./dist/federation-discovery/index.d.mts",
      "import": "./dist/federation-discovery/index.mjs"
    },
    "./activitypub": {
      "types": "./dist/activitypub/index.d.mts",
      "import": "./dist/activitypub/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.mts",
      "import": "./dist/mcp/index.mjs"
    },
    "./session-carrier": {
      "types": "./dist/session-carrier/index.d.mts",
      "import": "./dist/session-carrier/index.mjs"
    },
    "./sync-guard": {
      "types": "./dist/sync-guard/index.d.mts",
      "import": "./dist/sync-guard/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/animating": "workspace:*",
    "@red-cup-engineering/computer-serialized-content-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-web-server": "workspace:*",
    "@red-cup-engineering/http-server-core-service": "workspace:*",
    "@red-cup-engineering/html-file-codec-service": "workspace:*",
    "@red-cup-engineering/relating": "workspace:*",
    "@red-cup-engineering/computing-with-http": "workspace:*",
    "@red-cup-engineering/uri-services-section": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "sideEffects": false
}
